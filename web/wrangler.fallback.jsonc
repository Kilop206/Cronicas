{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cronicas-fallback",
  "main": "./fallback-worker.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/cronicas/browser",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "API_ORIGIN": "https://cronicas-api-r4nx.onrender.com"
  }
}
