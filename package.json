{
  "name": "cronicas-deploy",
  "private": true,
  "scripts": {
    "build:web": "npm --prefix web run build",
    "test:pages-proxy": "node --test scripts/pages-proxy.test.mjs",
    "test:spa-routes": "node --test scripts/spa-routes.test.mjs",
    "deploy:pages": "wrangler pages deploy dist/cronicas/browser --project-name cronicas --cwd web"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
