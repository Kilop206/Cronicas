{
  "name": "cronicas-deploy",
  "private": true,
  "scripts": {
    "build:web": "npm --prefix web run build",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "deploy:api": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy dist/cronicas/browser --project-name cronicas --cwd web"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
