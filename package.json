{
  "name": "cronicas-deploy",
  "private": true,
  "scripts": {
    "test:quality": "node --test scripts/quality.test.mjs",
    "preview:quality": "node scripts/quality-preview.mjs",
    "test:architecture": "node --test scripts/architecture.test.mjs",
    "test:plugins": "node scripts/sync-rpg-plugins.mjs --check && node scripts/check-sheet-templates.mjs",
    "build:web": "npm --prefix web run build",
    "test:pages-proxy": "node --test scripts/pages-proxy.test.mjs",
    "test:spa-routes": "node --test scripts/spa-routes.test.mjs",
    "deploy:pages": "wrangler pages deploy dist/cronicas/browser --project-name cronicas --cwd web"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
