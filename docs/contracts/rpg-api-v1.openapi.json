        "required": [
          "sourceVersionId",
          "targetVersionId",
          "previewHash",
          "mappings",
          "adjustedKeys",
          "appliedAt"
        ],
        "type": "object",
        "properties": {
          "sourceVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "targetVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "previewHash": {
            "type": "string"
          },
          "mappings": {
