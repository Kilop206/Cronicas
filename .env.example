POSTGRES_DB=cronicas
POSTGRES_USER=cronicas
POSTGRES_PASSWORD=change-this-local-password
ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:8081,http://localhost:8081

